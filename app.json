{
  "expo": {
    "name": "Genius Finance",
    "slug": "genius-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "owner": "jvitorafb",
    "scheme": "geniusfinance",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.geniusweb.finance",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["com.googleusercontent.apps.398903461844-fkqevpvg5d92icmvplvl9shic32b8c7r"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e293b",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.geniusweb.finance"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}
